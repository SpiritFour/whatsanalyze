# Production Environment Variables
#
# The site's own project, which takes over the Stripe functions from
# whatsanalyze-wrapped-prod. Same Stripe account and the same live prices, so
# customers, subscriptions and the coupon carry over untouched -- only the
# project the webhook is delivered to changes.

# Public Stripe Key (Live Mode)
STRIPE_PUBLISHABLE_KEY=pk_live_51SWEboL4rDqbYflo9zu46Mte4TajSTLu4q1qTgNF7ywYeqHreCr0xpjptrl4bxhQ0DCClx6D0iRQrttP4waTX5Gy009B1hstFl

# Price IDs (Live Mode)
PRO_PRICE_ID=price_1UGedRL4rDqbYflomrrqwaYy
ONE_TIME_PRICE_ID=price_1UEjQ4L4rDqbYflo33cJS7RR

# Stripe coupon applied to the first subscription invoice so the advertised
# reduced first month is actually charged. Coupons are per Stripe mode, so a
# test coupon id is invalid here and vice versa. Create one per mode:
#   duration=once, currency=eur, amount_off = full price - intro price
# Leave empty to sell the subscription at full price with no intro offer.
INTRO_COUPON_ID=cTCLzaDA

# Allowed Origins (comma-separated). wrapped.whatsanalyze.com stays until the
# old site stops serving, because its share links keep landing there.
ALLOWED_ORIGINS=https://wrapped.whatsanalyze.com,https://whatsanalyze.com,https://www.whatsanalyze.com,https://whatsanalyze-80665.web.app,https://whatsanalyze-80665.firebaseapp.com,https://whatsanalyze-80665--*.web.app,http://localhost:3000,http://localhost:5173

# Base Url used in Email Templates. /subscribe is served from the site itself,
# not from the old wrapped hosting, whose ** -> /index.html rewrite answers 200
# for paths its SPA cannot route.
EMAIL_BASE_URL=https://whatsanalyze.com

# This deployment is now the only one that mails. The old endpoint on
# whatsanalyze-wrapped-prod (we_1SeeXYL4rDqbYflolVUjE6OD) was deleted at the
# 2026-09-19 cutover, so Stripe delivers each event here alone. Were a second
# endpoint ever registered against the same Stripe account again, this has to
# go back to false first -- nothing downstream deduplicates, so both
# deployments would mail every new subscriber.
SEND_CONFIRMATION_EMAIL=true

APP_NAME=whatsanalyze-80665
