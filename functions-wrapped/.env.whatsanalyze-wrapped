# Base Url used in Email Templates. Has to be where the dev frontend serves
# /subscribe, which is the site's own hosting: whatsanalyze-wrapped.web.app
# still answers, but its ** -> /index.html rewrite makes every path return 200
# while the wrapped SPA fails to route.
EMAIL_BASE_URL=https://whatsanalyze-80665.web.app

# Only the live projects share a Stripe account and have to stay quiet about
# each other's invoices. This one is on its own test account, so it mails the
# confirmation -- which is how the email gets tested before it reaches a
# customer. Deploying without a value here prompts for one.
SEND_CONFIRMATION_EMAIL=true

APP_NAME=whatsanalyze-wrapped

