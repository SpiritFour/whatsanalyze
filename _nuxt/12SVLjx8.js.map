  "exportGuide": {
    "title": "How to export your WhatsApp chat?",
    "ios": "iOS",
    "android": "Android",
    "iosSteps": [
      "Open WhatsApp and go to the chat you want to export",
      "Tap on the chat name at the top",
      "Scroll down and tap \"Export Chat\"",
      "Choose \"Without Media\" or \"Including Media\"",
      "Select how you want to share the file (Email, iCloud Drive, etc.)",
      "Select your file and follow the prompts to export",
      "Share the exported .txt file with WhatsApp Wrapped"
    ],
    "androidSteps": [
      "Open WhatsApp and long-press on the chat you want to export",
      "Tap the three-dot menu icon",
      "Select \"More\" > \"Export Chat\"",
      "Choose \"Without Media\" or \"Including Media\"",
      "Select how you want to share the file",
      "Share the exported .txt file with WhatsApp Wrapped"
    ],
    "info": {
      "title": "Handle large exports on a computer",
      "description": "WhatsAnalyze processes everything locally in your browser, so huge TXT or ZIP exports can slow down phones. For smoother processing, send the exported file to your computer first and run the analysis there."
    },
    "coming_soon": "Android guide coming soon"
  },
