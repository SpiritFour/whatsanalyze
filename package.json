{
  "name": "chat-analyzer-nuxt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.8",
  "engines": {
    "node": ">=22.19 <23",
    "pnpm": "8.15.8"
  },
  "scripts": {
    "dev": "NUXT_ENV_LOCAL=1 nuxt dev",
    "dev-with-functions": "NUXT_ENV_WITH_FUNCTIONS=1 NUXT_ENV_LOCAL=1 nuxt dev",
    "functions": ">&2 echo 'you have to run this without pnpm, ohterwise the access to the secrets somehow does not work\nfirebase emulators:start --only functions'",
    "deploy-functions:dev": "npm --prefix functions run build && firebase deploy --only functions --project dev",
    "deploy-functions:prod": "npm --prefix functions run build && firebase deploy --only functions --project default",
    "generate": "nuxt generate",
    "start": "nuxt preview",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "build:e2e": "NUXT_ENV_LOCAL=1 nuxt generate",
    "serve:e2e": "serve dist --listen 4173 --no-port-switching",
    "test:generated": "node scripts/verify-generated-site.js",
    "local": "NUXT_ENV_LOCAL=1 nuxt generate && NUXT_ENV_LOCAL=1 nuxt preview",
    "ci-dev-build": "NUXT_ENV_LOCAL=1 nuxt generate",
    "deploy": "nuxt generate && push-dir --dir=dist --branch=gh-pages --cleanup",
    "deploy-sebi": "nuxt generate && rm dist/CNAME && push-dir --remote=https://github.com/fellnerse/fellnerse.github.io.git --dir=dist --branch=gh-pages --cleanup",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.{js,vue,ts}": "eslint --cache --fix",
    "*.{js,css,md,vue}": "prettier --write"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "@heroicons/vue": "^2.2.0",
    "@mdi/font": "^7.4.47",
    "@nuxt/content": "3.16.1",
    "@nuxt/scripts": "1.3.9",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/nuxt": "10.75.2",
    "@vite-pwa/nuxt": "1.1.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "emoji-aware": "^3.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "moment": "^2.31.0",
    "motion": "^13.4.1",
    "nuxt": "4.5.2",
    "pako": "^3.0.2",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "promise-worker": "^2.0.1",
    "push-dir": "^0.4.1",
    "sass": "^1.105.0",
    "stopwords-de": "^0.3.0",
    "stopwords-en": "^0.3.0",
    "uuid": "^14.0.2",
    "vue": "3.5.43",
    "vue-chartjs": "^5.3.4",
    "vuetify": "3.13.3",
    "vuetify-nuxt-module": "0.19.5",
    "whatsapp-chat-parser": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-jest": "^30.5.2",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "firebase-tools": "^15.30.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^10.5.4",
    "prettier": "3.9.8",
    "serve": "^14.2.6"
  }
}
