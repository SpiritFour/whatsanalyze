{
  "name": "chat-analyzer-nuxt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.8",
  "engines": {
    "node": ">=22.19 <23",
    "pnpm": "8.15.8"
  },
  "scripts": {
    "dev": "NUXT_ENV_LOCAL=1 nuxt dev",
    "dev-with-functions": "NUXT_ENV_WITH_FUNCTIONS=1 NUXT_ENV_LOCAL=1 nuxt dev",
    "functions": ">&2 echo 'you have to run this without pnpm, ohterwise the access to the secrets somehow does not work\nfirebase emulators:start --only functions'",
    "deploy-functions": "firebase deploy --only functions",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "start": "nuxt preview",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:sandbox": "playwright test --config playwright.sandbox.config.js",
    "test:generated": "node scripts/verify-generated-site.js",
    "local": "NUXT_ENV_LOCAL=1 nuxt generate && NUXT_ENV_LOCAL=1 nuxt preview",
    "ci-dev-build": "NUXT_ENV_LOCAL=1 nuxt generate",
    "deploy": "nuxt generate && push-dir --dir=dist --branch=gh-pages --cleanup",
    "deploy-sebi": "nuxt generate && rm dist/CNAME && push-dir --remote=https://github.com/fellnerse/fellnerse.github.io.git --dir=dist --branch=gh-pages --cleanup",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.{js,vue}": "eslint --cache --fix",
    "*.{js,css,md,vue}": "prettier --write"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.38",
    "@mdi/font": "^7.4.47",
    "@nuxt/content": "3.16.0",
    "@nuxt/scripts": "1.3.8",
    "@nuxtjs/i18n": "10.6.0",
    "@sentry/nuxt": "10.73.0",
    "@vite-pwa/nuxt": "1.1.1",
    "canvg": "^3.0.10",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "country-currency-map": "^2.1.7",
    "date-fns": "^4.1.0",
    "dompurify": "^2.4.7",
    "emoji-aware": "^3.1.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.1",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "moment": "^2.30.1",
    "nuxt": "4.5.2",
    "pako": "^2.1.0",
    "push-dir": "^0.4.1",
    "stopwords-de": "^0.3.0",
    "stopwords-en": "^0.3.0",
    "vue": "3.5.42",
    "vue-chartjs": "^5.3.3",
    "vuetify": "3.13.3",
    "vuetify-nuxt-module": "0.19.5",
    "whatsapp-chat-parser": "^3.2.3",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@playwright/test": "1.62.1",
    "@nuxtjs/eslint-config-typescript": "^6.0.1",
    "@types/pako": "^2.0.3",
    "babel-jest": "^26.6.3",
    "better-sqlite3": "^12.6.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-vue": "^7.20.0",
    "firebase-tools": "^15.5.1",
    "husky": "4.2.3",
    "jest": "^26.6.3",
    "lint-staged": "^10.5.4",
    "prettier": "2.2.1"
  }
}
